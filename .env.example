# ============================================================================
# FARMORA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: Keep all real secrets in your private .env file or Vercel Environment Variables.
# NEVER commit real API keys to the repository.
# ============================================================================

# ─── SERVER CONFIGURATION ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# ─── SUPABASE DATABASE & AUTHENTICATION ─────────────────────────────────────
# Used server-side and client-side for PostgreSQL database, Auth & Realtime GPS
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_PROJECT_REF=your_supabase_project_ref_here

# ─── TAMIL VOICE-TO-TEXT & TRANSLATION ENGINE (OPTIONAL) ───────────────────
# Voice STT uses Browser Web Speech API (Free / Zero Key needed).
# Backend translation uses built-in Agri Dictionary & MyMemory (Free / Zero Key needed).
# Optional AI Enhancement keys (Server-side only):
SARVAM_API_KEY=your_sarvam_ai_translation_key_here
VOICE_TRANSLATOR_API_KEY=your_voice_translator_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── AI SMART AGRICULTURE & CLIMATE TELEMETRY (OPTIONAL) ───────────────────
# Used server-side for automated crop leaf pathology and live agro-weather yield estimation
CROP_DISEASE_API_KEY=your_kindwise_plant_disease_api_key_here
CROP_YIELD_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ─── MAP TRACKING ───────────────────────────────────────────────────────────
# Delivery GPS Tracking uses Leaflet 1.9.4 + OpenStreetMap + W3C Geolocation
# Zero paid map API key required (100% Free / Open Source stack).
